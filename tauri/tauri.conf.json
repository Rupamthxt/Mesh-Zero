{
  "build": {
    "distDir": "../../mesh-zero-web/dist",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "MeshZero",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.meshzero.app",
      "icon": [],
      "externalBin": [
        "bin/mesh-zero"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MeshØ: Compute Marketplace",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
